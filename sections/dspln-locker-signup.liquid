{%- comment -%}
  The sign-up page. Every other storefront page sends people to the Locker to
  sign in; this one exists to make them join, and it is the only page that
  pays out the free shipping code the announcement bar promises.

  It does NOT auto-forward — a page that vanishes cannot make an offer. It
  states the offer and sends people to the Locker's create-account screen,
  which reveals the code once the account exists.

  A customer who still holds a Shopify session is carried through with their
  identity, so they land in a Locker that already holds their work.
{%- endcomment -%}

{%- liquid
  assign locker_origin = 'https://locker.dspln.com'
  if shop.permanent_domain contains 'dspln-dev-2'
    assign locker_origin = 'https://dev--dspln-dawn-shopify-theme.netlify.app'
  endif
-%}

{%- capture signup_url -%}
{%- if customer -%}
{{ locker_origin }}/locker?offer=free-shipping&shop={{ shop.permanent_domain | url_encode }}&storefrontOrigin={{ request.origin | url_encode }}&customerId={{ customer.id | url_encode }}&customerEmail={{ customer.email | url_encode }}&firstName={{ customer.first_name | url_encode }}&lastName={{ customer.last_name | url_encode }}
{%- else -%}
{{ locker_origin }}/locker?auth=sign-up&offer=free-shipping
{%- endif -%}
{%- endcapture -%}
{%- assign signup_url = signup_url | strip -%}

<style>
  .dspln-signup { background: #fff; padding: 72px 24px 96px; }
  .dspln-signup__inner { max-width: 560px; margin: 0 auto; text-align: center; }
  .dspln-signup__mark {
    display: flex; width: 58px; height: 58px; margin: 0 auto 28px; align-items: center;
    justify-content: center; background: #1c1b1b; color: #fff; font-size: 24px;
  }
  .dspln-signup__eyebrow {
    margin: 0 0 14px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #8a1c1c;
  }
  .dspln-signup h1 {
    margin: 0 0 18px; font-size: 30px; line-height: 1.25; letter-spacing: .16em; text-transform: uppercase;
  }
  .dspln-signup__body { margin: 0 auto 34px; max-width: 460px; color: #666; font-size: 15px; line-height: 1.75; }
  .dspln-signup__cta {
    display: flex; min-width: 300px; min-height: 60px; margin: 0 auto; align-items: center;
    justify-content: center; background: #1c1b1b; color: #fff;
    font-size: 13px; letter-spacing: .18em; text-transform: uppercase; text-decoration: none;
  }
  .dspln-signup__cta:hover { color: #fff; opacity: .88; }
  .dspln-signup__signin { margin-top: 20px; font-size: 13px; color: #8a8580; }
  .dspln-signup__signin a { color: #1c1b1b; }
  .dspln-signup__perks {
    margin: 52px auto 0; padding: 0; max-width: 460px; list-style: none;
    display: grid; gap: 18px; text-align: left;
  }
  .dspln-signup__perks li {
    display: grid; grid-template-columns: 22px 1fr; gap: 14px; align-items: start;
    font-size: 14px; line-height: 1.65; color: #444;
  }
  .dspln-signup__perks span { color: #8a1c1c; font-size: 12px; letter-spacing: .1em; }
  @media screen and (max-width: 749px) {
    .dspln-signup { padding: 48px 20px 72px; }
    .dspln-signup h1 { font-size: 24px; }
    .dspln-signup__cta { min-width: 0; width: 100%; }
  }
</style>

<section class="dspln-signup">
  <div class="dspln-signup__inner">
    <div class="dspln-signup__mark">D</div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="dspln-signup__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p class="dspln-signup__body">{{ section.settings.body }}</p>

    <a class="dspln-signup__cta" href="{{ signup_url }}">{{ section.settings.button_label }}</a>

    <p class="dspln-signup__signin">
      Already have an account?
      <a href="{{ locker_origin }}/locker">Sign in to your Locker</a>
    </p>

    <ul class="dspln-signup__perks">
      <li><span>01</span><div>{{ section.settings.perk_one }}</div></li>
      <li><span>02</span><div>{{ section.settings.perk_two }}</div></li>
      <li><span>03</span><div>{{ section.settings.perk_three }}</div></li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Locker Sign Up",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free shipping on your first order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join DSPLN" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Create your account and we will hand you your free shipping code on the spot. Your designs, artwork, sizing and orders all live in your Locker from then on." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create your account" },
    { "type": "text", "id": "perk_one", "label": "Perk 1", "default": "Free shipping code, revealed the moment your account exists." },
    { "type": "text", "id": "perk_two", "label": "Perk 2", "default": "Every design you have made is saved, and picked back up on any device." },
    { "type": "text", "id": "perk_three", "label": "Perk 3", "default": "Track production and delivery, and talk to us about any order." }
  ],
  "presets": [{ "name": "Locker Sign Up" }]
}
{% endschema %}
